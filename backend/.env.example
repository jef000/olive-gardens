# Server Configuration
NODE_ENV=development
PORT=5000

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=olive_garden_db
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_MAX_CONNECTIONS=20

# JWT Configuration
# REQUIRED: the server refuses to start while this is still the example value.
# Generate strong secret using: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRY=1h

# CORS Configuration
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
BCRYPT_ROUNDS=12

# Trusted proxy hops for X-Forwarded-For (leave false unless the API sits
# behind a reverse proxy/CDN that overwrites the header; then set 1).
TRUST_PROXY=false

# First admin bootstrap (used by `npm run db:setup`; rotate after first login)
ADMIN_EMAIL=admin@olivegarden.com
# Leave empty to auto-generate and print a random password once.
ADMIN_PASSWORD=

# Email Configuration (for password reset)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@olivegarden.com

# Frontend URL (for password reset links)
FRONTEND_URL=http://localhost:3000

# Password Reset Token Expiry (in milliseconds)
RESET_TOKEN_EXPIRY=3600000

# Redis Configuration (optional)
# Leave REDIS_URL unset to use the built-in in-memory store
# (recommended on shared hosting without Redis, e.g. cPanel/Passenger).
# REDIS_URL=redis://localhost:6379
# Force a specific mode when both are available:
# REDIS_MODE=memory   -> always in-memory
# REDIS_MODE=redis    -> always connect to REDIS_URL
