{
  "name": "olive-garden-backend-pg",
  "version": "1.0.0",
  "description": "Production-ready Node.js backend API with PostgreSQL",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "set NODE_ENV=test&& node --test --test-concurrency=1 --require ts-node/register/transpile-only --require ./tests/testEnv.ts \"tests/services/**/*.test.ts\" \"tests/middleware/**/*.test.ts\" \"tests/property/**/*.test.ts\"",
    "test:integration": "node scripts/run-integration-tests.js",
    "db:setup": "node -r dotenv/config scripts/setup-db.js",
    "seed:gallery": "node scripts/seed-gallery.js",
    "migrate": "ts-node -r dotenv/config scripts/run-migrations.ts"
  },
  "overrides": {
    "tar": "^7.5.21",
    "qs": "^6.15.4"
  },
  "keywords": [
    "express",
    "typescript",
    "postgresql",
    "api",
    "authentication"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.13.6",
    "bcrypt": "^5.1.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dompurify": "^3.3.3",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.3.1",
    "helmet": "^7.1.0",
    "ioredis": "^6.0.0",
    "jsdom": "^29.0.0",
    "jsonwebtoken": "^9.0.2",
    "mailgen": "^2.0.32",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "nodemailer": "^10.0.10",
    "otplib": "^13.5.0",
    "pg": "^8.11.3",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^28.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mailgen": "^2.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.11.5",
    "@types/nodemailer": "^6.4.23",
    "@types/pg": "^8.10.9",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
